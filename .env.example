# Database — matches the db service in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@db:5432/ragdb

# LLM provider: "ollama" for local (default) or "openai" for hosted
LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=

# Embedding dimension — must match across both providers (see ADR-001)
EMBED_DIM=768

# Auth — generate a strong random secret for production
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-before-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Set to true in production (requires HTTPS)
SECURE_COOKIES=false

# Optional — web search via Tavily. Leave empty to disable.
TAVILY_API_KEY=
